# ============================================================
# BlitzLearn / Doc Genius - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# 1. AI & LLM (Required for RAG, PDF Q&A, and Exam Generation)
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------
# 2. MySQL Database Configuration
# ------------------------------------------------------------
# Option A: Single Connection URL (Recommended)
DATABASE_URL=mysql://root:your_mysql_password@localhost:3306/blitzlearn

# Option B: Individual Variables (Alternative)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=blitzlearn

# ------------------------------------------------------------
# 3. Application Security (Optional)
# ------------------------------------------------------------
FLASK_SECRET_KEY=blitzlearn-dev-secret-key-change-in-production

# ------------------------------------------------------------
# 4. Email / OTP Verification (Optional)
# ------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_USE_TLS=true

# ------------------------------------------------------------
# 5. Firebase Auth (Disabled / Optional)
# Leave blank or omit to run in standalone Guest Mode without Firebase.
# ------------------------------------------------------------
# FIREBASE_API_KEY=
